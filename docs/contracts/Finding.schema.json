{
  "$defs": {
    "JsonValue": {},
    "ReplayAction": {
      "additionalProperties": false,
      "properties": {
        "acceptable_statuses": {
          "items": {
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": "Acceptable Statuses",
          "type": "array"
        },
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "expected_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Status"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "agent_id",
        "request"
      ],
      "title": "ReplayAction",
      "type": "object"
    },
    "ReplayPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ReplayStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "seed",
        "steps"
      ],
      "title": "ReplayPlan",
      "type": "object"
    },
    "ReplayStep": {
      "additionalProperties": false,
      "description": "Actions inside a step start together; steps finish in sequence.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ReplayAction"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "actions"
      ],
      "title": "ReplayStep",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "json_body": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Query",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "title": "Request",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_events": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Events",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "involved_agents": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Involved Agents",
      "type": "array"
    },
    "mapped_bug_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapped Bug Id"
    },
    "minimal_repro_sequence": {
      "$ref": "#/$defs/ReplayPlan"
    },
    "oracle_triggered": {
      "minLength": 1,
      "title": "Oracle Triggered",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "suggested_fix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggested Fix"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "enum": [
        "single-user",
        "emergent"
      ],
      "title": "Type",
      "type": "string"
    },
    "verified": {
      "default": false,
      "title": "Verified",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "title",
    "severity",
    "type",
    "evidence_events",
    "involved_agents",
    "minimal_repro_sequence",
    "oracle_triggered"
  ],
  "title": "Finding",
  "type": "object"
}
