  "components": {
    "schemas": {
      "BlockRequest": {
        "properties": {
          "blocker_id": {
            "type": "integer",
            "title": "Blocker Id"
          },
          "blocked_id": {
            "type": "integer",
            "title": "Blocked Id"
          }
        },
        "type": "object",
        "required": [
          "blocker_id",
          "blocked_id"
        ],
        "title": "BlockRequest"
      },
      "CartRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "item_id",
          "quantity"
        ],
        "title": "CartRequest"
      },
      "CheckoutRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "race_delay_ms": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Race Delay Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "CheckoutRequest"
      },
      "CouponRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "race_delay_ms": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Race Delay Ms",
            "default": 75
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "code"
        ],
        "title": "CouponRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PayoutRequest": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "amount_cents": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Cents"
          },
          "race_delay_ms": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Race Delay Ms",
            "default": 75
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "PayoutRequest"
      },
      "QuestionRequest": {
        "properties": {
          "author_id": {
            "type": "integer",
            "title": "Author Id"
          },
          "body": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "author_id",
          "body"
        ],
        "title": "QuestionRequest"
      },
      "ReviewRequest": {
        "properties": {
          "author_id": {
            "type": "integer",
            "title": "Author Id"
          },
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "body": {
            "type": "string",
            "maxLength": 1000,
            "title": "Body",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "author_id",
          "rating"
        ],
        "title": "ReviewRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
